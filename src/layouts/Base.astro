---
import { ArrowUp, Palette } from 'lucide-astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props { title?: string; description?: string; bodyClass?: string; image?: string; }
const { title = 'Lufu_Enter', description = '一个属于我的小站', bodyClass = '', image = '' } = Astro.props;
const site = 'Lufu_Enter';
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
// 首页区块锚点(全站顶栏统一指向首页区块)
const sections = [
  { id: 'hero', label: '首页' },
  { id: 'about', label: '关于' },
  { id: 'search', label: '搜索' },
  { id: 'gallery', label: '相册' },
  { id: 'posts', label: '文章' },
  { id: 'friends', label: '友链' },
];
const links = sections.map((sec) => ({
  href: isHome ? `#${sec.id}` : `/#${sec.id}`,
  label: sec.label,
  anchor: isHome,
}));
// 独立页高亮映射
const pageHash = pathname.startsWith('/about')
  ? '#about'
  : pathname.startsWith('/search')
    ? '#search'
    : pathname.startsWith('/gallery')
      ? '#gallery'
      : pathname.startsWith('/posts')
        ? '#posts'
        : pathname.startsWith('/friends')
          ? '#friends'
          : '';
const origin = (Astro.site || new URL('https://lufusblog.top')).origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = image ? new URL(image, origin).href : new URL('/og.png', origin).href;
const ogTitle = title === site ? site : `${title} · ${site}`;
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>{ogTitle}</title>
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="alternate" type="application/rss+xml" title="Lufu_Enter" href="/rss.xml" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <ClientRouter />
  <script is:inline>
    (function () {
      try {
        var p = localStorage.getItem('palette');
        if (p) document.documentElement.setAttribute('data-palette', p);
      } catch (e) {}
    })();
  </script>
</head>
<body class={bodyClass}>
  <div class="bg-media" aria-hidden="true">
    <video src="/bg/evening.mp4" poster="/bg/evening.jpg" muted loop playsinline preload="auto"></video>
    <video src="/bg/aurora.mp4" poster="/bg/aurora.jpg" muted loop playsinline preload="none"></video>
    <video src="/bg/winter.mp4" poster="/bg/winter.jpg" muted loop playsinline preload="none"></video>
    <div class="bg-veil"></div>
  </div>
  <div class="load-bar" id="loadBar" aria-hidden="true"></div>
  {pathname.startsWith('/posts/') && <div class="read-progress" id="readProgress" aria-hidden="true"></div>}

  <header class="site-header">
    <div class="wrap dock">
      <a class="brand" href="/">{site}<span class="dot">.</span></a>
      <nav class="nav">
        {links.map((l) => (
          <a
            href={l.href}
            data-anchor={l.anchor ? '' : undefined}
            class:list={[{ active: !isHome && l.href.endsWith(pageHash) && pageHash !== '' }]}
          >{l.label}</a>
        ))}
      </nav>
      <div class="palette" id="palette">
        <button class="palette-btn" id="paletteBtn" aria-label="切换主题配色" title="切换主题配色">
          <Palette size={16} />
        </button>
        <div class="palette-menu" id="paletteMenu">
          <button data-palette="deep"><i style="--c:#6ea8ff"></i>深海夜</button>
          <button data-palette="sakura"><i style="--c:#fb7299"></i>樱夜</button>
          <button data-palette="sea"><i style="--c:#2f9fd0"></i>碧海</button>
          <button data-palette="amber"><i style="--c:#d99a2b"></i>暮光</button>
        </div>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {site} · 用 Astro 搭建</span>
      <span>Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></span>
    </div>
  </footer>

  <button class="to-top" id="toTop" aria-label="回到顶部"><ArrowUp size={18} /></button>

  {/* 图片灯箱 */}
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <img id="lightboxImg" alt="" />
  </div>

  <script>
    const w = window as any;

    function init() {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 滚动出现动画(含标题展开)
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal:not(.in), .title-anim:not(.in)').forEach((el) => io.observe(el));

      // 回到顶部 + 阅读进度
      const top = document.getElementById('toTop');
      const bar = document.getElementById('readProgress');
      const onScroll = () => {
        if (top) top.classList.toggle('show', scrollY > 420);
        if (bar) {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
        }
      };
      if (w.__onScroll) removeEventListener('scroll', w.__onScroll);
      w.__onScroll = onScroll;
      addEventListener('scroll', w.__onScroll, { passive: true });
      onScroll();
      if (top) top.onclick = () => scrollTo({ top: 0, behavior: 'smooth' });

      // 图片灯箱
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
      document.querySelectorAll('.prose img, .zoomable').forEach((img) => {
        (img as HTMLImageElement).style.cursor = 'zoom-in';
        (img as HTMLImageElement).onclick = () => {
          if (!lb || !lbImg) return;
          lbImg.src = (img as HTMLImageElement).src;
          lb.classList.add('show');
          document.body.style.overflow = 'hidden';
        };
      });
      const close = () => { if (lb) lb.classList.remove('show'); document.body.style.overflow = ''; };
      if (lb) lb.onclick = close;
      if (w.__onKey) removeEventListener('keydown', w.__onKey);
      w.__onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
      addEventListener('keydown', w.__onKey);

      // 统计数字滚动
      const counters = document.querySelectorAll('[data-count]');
      if (counters.length && !reduce) {
        if (w.__counterIO) w.__counterIO.disconnect();
        const cio = new IntersectionObserver((es) => {
          for (const e of es) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            cio.unobserve(el);
            const raw = el.dataset.count || '0';
            const target = Number(raw);
            const decimals = raw.includes('.') ? 1 : 0;
            const t0 = performance.now();
            const step = (now: number) => {
              const p = Math.min(1, (now - t0) / 900);
              el.textContent = (target * (1 - Math.pow(1 - p, 3))).toFixed(decimals);
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        }, { threshold: 0.4 });
        counters.forEach((c) => cio.observe(c));
        w.__counterIO = cio;
      }

      // 卡片光斑 + 3D 倾斜(全局委托, 只绑一次)
      if (!reduce && !w.__pointerFx) {
        w.__pointerFx = true;
        document.addEventListener('pointermove', (e) => {
          const t = e.target as HTMLElement;
          if (!t.closest) return;
          const spot = t.closest('.post-card, .profile-card, .gallery-item') as HTMLElement | null;
          if (spot) {
            const r = spot.getBoundingClientRect();
            spot.style.setProperty('--mx', `${e.clientX - r.left}px`);
            spot.style.setProperty('--my', `${e.clientY - r.top}px`);
          }
          const tilt = t.closest('.profile-card') as HTMLElement | null;
          if (tilt) {
            const r = tilt.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            tilt.style.setProperty('--ry', `${(px * 7).toFixed(2)}deg`);
            tilt.style.setProperty('--rx', `${(-py * 7).toFixed(2)}deg`);
          }
        });
        document.addEventListener('pointerout', (e) => {
          const t = e.target as HTMLElement;
          const tilt = t.closest?.('.profile-card') as HTMLElement | null;
          if (tilt && !tilt.contains(e.relatedTarget as Node)) {
            tilt.style.setProperty('--rx', '0deg');
            tilt.style.setProperty('--ry', '0deg');
          }
        });
      }

      // 主题配色切换
      const pal = document.getElementById('palette');
      const palBtn = document.getElementById('paletteBtn');
      const palMenu = document.getElementById('paletteMenu');
      if (pal && palBtn && palMenu) {
        palBtn.onclick = (e) => {
          e.stopPropagation();
          pal.classList.toggle('open');
        };
        palMenu.querySelectorAll('button[data-palette]').forEach((b) => {
          (b as HTMLElement).onclick = () => {
            const name = (b as HTMLElement).dataset.palette || 'deep';
            document.documentElement.setAttribute('data-palette', name);
            try { localStorage.setItem('palette', name); } catch {}
            pal.classList.remove('open');
            document.dispatchEvent(new CustomEvent('palettechange', { detail: name }));
          };
        });
        if (!w.__paletteSync) {
          w.__paletteSync = true;
          addEventListener('storage', (e) => {
            if (e.key === 'palette' && e.newValue) {
              document.documentElement.setAttribute('data-palette', e.newValue);
              document.dispatchEvent(new CustomEvent('palettechange', { detail: e.newValue }));
            }
          });
        }
        if (!w.__palOutside) {
          w.__palOutside = true;
          document.addEventListener('click', (e) => {
            const p = document.getElementById('palette');
            if (p && !p.contains(e.target as Node)) p.classList.remove('open');
          });
        }
      }

      // 动态背景视频(随区块切换)
      if (!w.__bgVideos) {
        w.__bgVideos = true;
        const initBg = () => {
          const wrap = document.querySelector('.bg-media') as HTMLElement | null;
          if (!wrap) return;
          const vids = Array.from(wrap.querySelectorAll('video'));
          if (!vids.length) return;
          const saveData = (navigator as any).connection && (navigator as any).connection.saveData;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || saveData || window.innerWidth < 720) {
            vids.forEach((v) => v.remove());
            return;
          }
          let cur = -1;
          const setActive = (i: number) => {
            vids.forEach((v, k) => {
              const on = k === i;
              v.classList.toggle('on', on);
              if (on) { (v as HTMLVideoElement).play().catch(() => {}); }
              else { (v as HTMLVideoElement).pause(); }
            });
          };
          const map: Record<string, number> = { hero: 0, about: 1, search: 1, gallery: 2, posts: 2, friends: 2 };
          const hasHero = !!document.getElementById('hero');
          const update = () => {
            if (!hasHero) {
              // 非首页: 直接展示, 用第一段
              wrap.classList.add('show');
              if (cur !== 0) { cur = 0; setActive(0); }
              return;
            }
            const y = window.scrollY + 140;
            let sec = 'hero';
            for (const id of ['hero', 'about', 'search', 'gallery', 'posts', 'friends']) {
              const el = document.getElementById(id);
              if (el && el.getBoundingClientRect().top + window.scrollY <= y) sec = id;
            }
            // 封面不显示背景视频
            wrap.classList.toggle('show', sec !== 'hero');
            const idx = map[sec] ?? 0;
            if (idx !== cur) { cur = idx; setActive(idx); }
          };
          if (w.__bgScroll) removeEventListener('scroll', w.__bgScroll);
          w.__bgScroll = update;
          addEventListener('scroll', w.__bgScroll, { passive: true });
          update();
        };
        document.addEventListener('astro:page-load', initBg);
        initBg();
      }

      // 自定义光标: 首次真实鼠标移动时启用(触屏/减少动效自动跳过)
      if (!w.__cursorFx) {
        w.__cursorFx = true;
        const startCursor = () => {
          if (document.querySelector('.cursor-dot')) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const dot = document.createElement('div');
          dot.className = 'cursor-dot';
          const ring = document.createElement('div');
          ring.className = 'cursor-ring';
          document.body.append(dot, ring);
          document.documentElement.classList.add('has-cursor-fx');
          let mx = -100, my = -100, rx2 = -100, ry2 = -100;
          addEventListener('pointermove', (e) => {
            mx = e.clientX; my = e.clientY;
            dot.style.transform = `translate(${mx}px, ${my}px)`;
          }, { passive: true });
          const follow = () => {
            rx2 += (mx - rx2) * 0.16;
            ry2 += (my - ry2) * 0.16;
            ring.style.transform = `translate(${rx2}px, ${ry2}px)`;
            requestAnimationFrame(follow);
          };
          requestAnimationFrame(follow);
          document.addEventListener('pointerover', (e) => {
            const t = e.target as HTMLElement;
            const it = t.closest && t.closest('a, button, input, textarea, canvas, .post-card, .friend-card, .gallery-item');
            ring.classList.toggle('hover', !!it);
          });
          addEventListener('pointerdown', () => ring.classList.add('down'));
          addEventListener('pointerup', () => ring.classList.remove('down'));
          document.addEventListener('mouseleave', () => { dot.style.opacity = '0'; ring.style.opacity = '0'; });
          document.addEventListener('mouseenter', () => { dot.style.opacity = '1'; ring.style.opacity = '1'; });
        };
        addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') startCursor(); }, { passive: true });
      }

      // 标题 SVG 描边动画
      if (!w.__drawLines) {
        w.__drawLines = true;
        const io2 = new IntersectionObserver((es) => {
          for (const e of es) {
            if (e.isIntersecting) { e.target.classList.add('drawn'); io2.unobserve(e.target); }
          }
        }, { threshold: 0.5 });
        const injectLines = () => {
          document.querySelectorAll('.sub-title:not([data-dl]), .section-title:not([data-dl])').forEach((el) => {
            (el as HTMLElement).dataset.dl = '1';
            const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
            svg.setAttribute('class', 'draw-line');
            svg.setAttribute('viewBox', '0 0 120 8');
            svg.setAttribute('preserveAspectRatio', 'none');
            svg.setAttribute('aria-hidden', 'true');
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', 'M2 5 Q 20 1, 40 5 T 78 5 T 118 4');
            path.setAttribute('fill', 'none');
            path.setAttribute('stroke', 'currentColor');
            path.setAttribute('stroke-width', '2');
            path.setAttribute('stroke-linecap', 'round');
            svg.appendChild(path);
            el.insertAdjacentElement('afterend', svg);
            io2.observe(svg);
          });
        };
        document.addEventListener('astro:page-load', injectLines);
        injectLines();
      }

      // 翻页方向感知(按路径层级)
      if (!w.__navDir) {
        w.__navDir = true;
        document.addEventListener('click', (e) => {
          const a = (e.target as HTMLElement)?.closest?.('a[href^="/"]') as HTMLAnchorElement | null;
          if (!a) return;
          const seg = (p: string) => p.split('/').filter(Boolean).length;
          document.documentElement.dataset.nav =
            seg(a.getAttribute('href') || '/') < seg(location.pathname) ? 'back' : 'forward';
        }, true);
      }
    }

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);

    // 跨页 hash(#about 等) 跳转后滚动到目标区块
    const scrollToHash = () => {
      const hash = location.hash;
      if (!hash || hash.length < 2) return;
      const el = document.querySelector(hash) as HTMLElement | null;
      if (!el) return;
      const h = document.querySelector('.site-header') as HTMLElement | null;
      const hh = h ? h.offsetHeight : 64;
      requestAnimationFrame(() => {
        window.scrollTo({ top: Math.max(0, Math.round(el.getBoundingClientRect().top + window.scrollY - hh)), behavior: 'smooth' });
      });
    };
    document.addEventListener('astro:page-load', scrollToHash);
    document.addEventListener('astro:after-swap', scrollToHash);

    // 防切换页面回退: 每次导航后重新应用已保存的主题
    const applyPalette = () => {
      try {
        const p = localStorage.getItem('palette');
        if (p) document.documentElement.setAttribute('data-palette', p);
      } catch {}
    };
    document.addEventListener('astro:after-swap', applyPalette);
    document.addEventListener('astro:page-load', applyPalette);

    // 导航加载条
    document.addEventListener('astro:before-preparation', () => {
      const lb = document.getElementById('loadBar');
      if (!lb) return;
      lb.style.transition = 'none';
      lb.style.opacity = '1';
      lb.style.transform = 'scaleX(.12)';
      requestAnimationFrame(() => {
        lb.style.transition = 'transform 1.4s cubic-bezier(.1,.6,.2,1)';
        lb.style.transform = 'scaleX(.85)';
      });
    });
    document.addEventListener('astro:page-load', () => {
      const lb = document.getElementById('loadBar');
      if (!lb) return;
      lb.style.transition = 'transform .2s ease, opacity .3s ease .15s';
      lb.style.transform = 'scaleX(1)';
      setTimeout(() => {
        lb.style.opacity = '0';
        lb.style.transform = 'scaleX(0)';
      }, 220);
    });
  </script>
</body>
</html>
