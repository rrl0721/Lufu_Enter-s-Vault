---
import Base from '../../layouts/Base.astro';
import AboutTabs from '../../components/AboutTabs.astro';
import { getSocial } from '../../lib/social';

const { bilibili, updatedAt } = await getSocial();
const avatar = bilibili.avatarLocal || bilibili.avatar;
---
<Base title="哔哩哔哩" bodyClass="bili-page">
  <canvas id="sakura" aria-hidden="true"></canvas>
  <article class="article wrap profile-page">
    <AboutTabs />
    <div class="profile-kicker">关于 · 我的主页</div>
    <h1>哔哩哔哩</h1>

    <div class="profile-card bili">
      <div class="profile-head">
        <img class="profile-avatar" src={avatar} alt={bilibili.name} width="96" height="96" />
        <div>
          <div class="profile-name">{bilibili.name}</div>
          {bilibili.sign && <div class="profile-sign">{bilibili.sign}</div>}
          <div class="profile-badges">
            {bilibili.level > 0 && <span class="pbadge lv">Lv{bilibili.level}</span>}
            {bilibili.vipLabel && <span class="pbadge vip">{bilibili.vipLabel}</span>}
            {bilibili.sex && <span class="pbadge">{bilibili.sex}</span>}
          </div>
        </div>
      </div>
      <div class="stats-grid">
        <div class="stat-box"><b>{bilibili.fans}</b><span>粉丝</span></div>
        <div class="stat-box"><b>{bilibili.following}</b><span>关注</span></div>
        <div class="stat-box"><b>{bilibili.videos}</b><span>投稿</span></div>
        <div class="stat-box"><b>{bilibili.likes}</b><span>获赞</span></div>
      </div>
    </div>

    {bilibili.bangumi.length > 0 && (
      <section class="media-section">
        <div class="section-sub"><h2>追番</h2>共 {bilibili.bangumiTotal} 部</div>
        <div class="media-grid bangumi">
          {bilibili.bangumi.map((b) => (
            <div class="media-card">
              <img class="media-cover" src={b.coverLocal || b.cover} alt={b.title} loading="lazy" />
              <div class="media-title">{b.title}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {bilibili.favFolders.map((f) => (
      <section class="media-section">
        <div class="section-sub"><h2>收藏夹 · {f.title}</h2>共 {f.count} 个内容</div>
        <div class="media-grid fav">
          {f.items.map((it) => (
            <div class="media-card">
              <img class="media-cover" src={it.coverLocal || it.cover} alt={it.title} loading="lazy" />
              <div class="media-title">{it.title}</div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <nav class="pager">
      <a href="/about/">← 关于</a>
      <a href="/about/steam/">Steam →</a>
    </nav>
    <div class="profile-updated">资料更新于 {updatedAt.slice(0, 10)}</div>
  </article>

  <script>
    // 飘落樱花
    function initSakura() {
      const canvas = document.getElementById('sakura') as HTMLCanvasElement | null;
      if (!canvas || canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rand = (a: number, b: number) => a + Math.random() * (b - a);
      const COLORS = ['#f9b8ce', '#f7a6c4', '#ffd0e0', '#fbc4d8'];
      let w = 0, h = 0, raf = 0;

      const petals: {
        x: number; y: number; size: number; vy: number; sway: number;
        phase: number; rot: number; vrot: number; color: string; alpha: number;
      }[] = [];

      const spawn = (initial: boolean) => ({
        x: rand(0, w),
        y: initial ? rand(-h, h) : rand(-40, -10),
        size: rand(7, 14),
        vy: rand(0.5, 1.4),
        sway: rand(0.5, 1.6),
        phase: rand(0, Math.PI * 2),
        rot: rand(0, Math.PI * 2),
        vrot: rand(-0.02, 0.02),
        color: COLORS[Math.floor(rand(0, COLORS.length))],
        alpha: rand(0.5, 0.9),
      });

      const resize = () => {
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const draw = (now: number) => {
        if (!canvas.isConnected) return;
        const t = now * 0.001;
        ctx.clearRect(0, 0, w, h);
        for (const p of petals) {
          p.y += p.vy;
          p.x += Math.sin(t * p.sway + p.phase) * 0.6;
          p.rot += p.vrot;
          if (p.y > h + 20) Object.assign(p, spawn(false));
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.ellipse(0, 0, p.size * 0.55, p.size * 0.3, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
        if (!reduce) raf = requestAnimationFrame(draw);
      };

      resize();
      window.addEventListener('resize', resize);
      for (let i = 0; i < 46; i++) petals.push(spawn(true));
      if (reduce) draw(0);
      else raf = requestAnimationFrame(draw);
    }
    document.addEventListener('astro:page-load', initSakura);
    initSakura();
  </script>
</Base>
