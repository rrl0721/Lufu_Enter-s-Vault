---
import Base from '../layouts/Base.astro';
import friendData from '../data/friends.json';

const friends = friendData as { name: string; url: string; desc: string; avatar: string }[];
---
<Base title="友链">
  <article class="article wrap">
    <h1 class="reveal">友链</h1>
    <p class="reveal" style="color:var(--muted)">一些朋友的小站，欢迎去看看。</p>
    <div class="friends reveal">
      {friends.map((f) => (
        <a class="friend-card" href={f.url} target="_blank" rel="noopener">
          <img class="fc-avatar" src={f.avatar} alt={f.name} loading="lazy" />
          <div class="fc-main">
            <div class="fc-name">{f.name}</div>
            <div class="fc-desc">{f.desc}</div>
          </div>
        </a>
      ))}
    </div>
    <p class="reveal" style="color:var(--muted);margin-top:24px;font-size:14px">
      想交换友链？在文章下留言，或邮件联系我。
    </p>
  </article>
</Base>
