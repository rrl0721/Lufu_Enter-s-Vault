---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getSocial } from '../lib/social';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const galleryItems = (await getCollection('gallery', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const { bilibili, steam } = await getSocial();
const steamState: Record<string, string> = {
  online: '在线', offline: '离线', 'in-game': '游戏中', away: '离开', snooze: '打盹', busy: '忙碌',
};
const friends = [
  { name: '示例朋友 A', url: 'https://example.com', desc: '写点技术' },
  { name: '示例朋友 B', url: 'https://example.org', desc: '生活与摄影' },
];
---
<Base>
  {/* ===== 封面 ===== */}
  <section class="hero" id="hero" data-slide>
    <canvas class="hero-dots" aria-hidden="true"></canvas>
    <img class="hero-bg" src="/hero-art.webp" alt="" aria-hidden="true" width="1000" height="1000" loading="eager" fetchpriority="high" />
    <div class="hero-inner">
      <div class="hero-status"><span class="pulse"></span>正在折腾 Astro</div>
      <h1 aria-label="你好，我是Lufu_Enter。">
        {[...'你好，我是'].map((c, i) => (
          <span class="ch" style={`--d:${(0.18 + i * 0.05).toFixed(2)}s`}>{c}</span>
        ))}
        <span class="grad ch-block" style="--d:.48s">Lufu_Enter</span>
        <span class="ch" style="--d:.72s">。</span>
      </h1>
      <p aria-label="这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。">
        <span class="type" data-text="这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。">这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。</span>
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#posts" data-anchor>阅读文章</a>
        <a class="btn" href="#about" data-anchor>关于我</a>
      </div>
      <div class="hero-social">
        <a class="social-btn" href="https://github.com/rrl0721" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub · rrl0721">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.01 11.01 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a class="social-btn" href="mailto:1510518297@qq.com" aria-label="邮箱 QQ" title="1510518297@qq.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.8 5.6L19.8 6H4.2zM4 8.2V18h16V8.2l-7.4 5.3a1 1 0 0 1-1.2 0L4 8.2z"/></svg>
        </a>
        <a class="social-btn" href="mailto:lzr20071130@outlook.com" aria-label="邮箱 Outlook" title="lzr20071130@outlook.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.8 5.6L19.8 6H4.2zM4 8.2V18h16V8.2l-7.4 5.3a1 1 0 0 1-1.2 0L4 8.2z"/></svg>
        </a>
        <a class="social-btn" href="/rss.xml" aria-label="RSS" title="RSS 订阅">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM3 10v3a8 8 0 0 1 8 8h3A11 11 0 0 0 3 10zm0-6v3a14 14 0 0 1 14 14h3A17 17 0 0 0 3 4z"/></svg>
        </a>
      </div>
    </div>
    <a class="hero-scroll" href="#about" data-anchor aria-label="向下滚动"><span></span></a>
  </section>

  {/* ===== 关于(3 个磁性子页) ===== */}
  <section class="page-section" id="about">
    <div class="page-grid">
      <aside class="page-outline">
        <div class="po-title">关于</div>
        <div class="po-sep"></div>
        <a href="#about-me" data-anchor>关于我</a>
        <a href="#about-home" data-anchor>我的主页</a>
        <a href="#about-contact" data-anchor>关于本站</a>
      </aside>
      <div class="page-body">
        <div class="sub-slide" id="about-me" data-slide>
          <h2 class="sub-title">关于我</h2>
          <div class="profile-mini">
            <img class="pm-avatar" src="/social/bilibili.jpg" alt="Lufu_Enter" loading="lazy" />
            <div class="pm-name">Lufu_Enter</div>
            <div class="pm-title">爱摸鱼的幻想家</div>
            <div class="pm-grid">
              <div class="pm-item school"><span>学校</span><b>安徽师范大学</b></div>
              <div class="pm-item loc"><span>现居</span><b>安徽芜湖</b></div>
              <div class="pm-item bday"><span>生日</span><b>11 月 30 日</b></div>
            </div>
          </div>
        </div>
        <div class="sub-slide" id="about-home" data-slide>
          <h2 class="sub-title">我的主页</h2>
          <div class="home-links">
            <a class="home-link bili" href="/about/bilibili/">
              <span class="hl-title">哔哩哔哩</span>
              <span class="hl-sub">{bilibili.name} · 粉丝 {bilibili.fans}</span>
            </a>
            <a class="home-link steam" href="/about/steam/">
              <span class="hl-title">Steam</span>
              <span class="hl-sub">{steam.name} · {steamState[steam.state] || steam.state}</span>
            </a>
          </div>
        </div>
        <div class="sub-slide" id="about-contact" data-slide>
          <h2 class="sub-title">关于本站</h2>
          <div class="prose">
            <ul>
              <li>用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 搭建</li>
              <li>托管在 <a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare</a></li>
              <li>源码在 <a href="https://github.com/rrl0721" target="_blank" rel="noopener">GitHub</a></li>
            </ul>
            <h3>联系我</h3>
            <ul>
              <li>邮箱：<a href="mailto:1510518297@qq.com">1510518297@qq.com</a> / <a href="mailto:lzr20071130@outlook.com">lzr20071130@outlook.com</a></li>
              <li>GitHub：<a href="https://github.com/rrl0721" target="_blank" rel="noopener">rrl0721</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 搜索 ===== */}
  <section class="page-section" id="search">
    <div class="page-grid">
      <aside class="page-outline">
        <div class="po-title">搜索</div>
        <div class="po-sep"></div>
        <a href="#search-slide" data-anchor>全文搜索</a>
      </aside>
      <div class="page-body">
        <div class="sub-slide" id="search-slide" data-slide>
          <h2 class="sub-title">搜索</h2>
          <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
          <div id="search-ui"></div>
          <script is:inline src="/pagefind/pagefind-ui.js"></script>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 相册 ===== */}
  <section class="page-section" id="gallery">
    <div class="page-grid">
      <aside class="page-outline">
        <div class="po-title">相册</div>
        <div class="po-sep"></div>
        <a href="#gallery-slide" data-anchor>带图记录</a>
      </aside>
      <div class="page-body">
        <div class="sub-slide" id="gallery-slide" data-slide>
          <h2 class="sub-title">相册</h2>
          <div class="gallery-grid">
            {galleryItems.map((it, i) => (
              <figure class="gallery-item reveal" style={`--rd:${i * 70}ms`}>
                <img class="zoomable" src={it.data.image} alt={it.data.title || it.data.note} loading="lazy" />
                <figcaption>
                  {it.data.title && <b>{it.data.title}</b>}
                  {it.data.note && <span>{it.data.note}</span>}
                  <time>{it.data.date.toLocaleDateString('zh-CN')}</time>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 文章 ===== */}
  <section id="posts" class="posts page-section">
    <canvas class="posts-fx" aria-hidden="true"></canvas>
    <div class="page-grid">
      <aside class="page-outline">
        <div class="po-title">文章</div>
        <div class="po-sep"></div>
        <a href="#posts-slide" data-anchor>最新文章</a>
      </aside>
      <div class="page-body">
        <div class="sub-slide" id="posts-slide" data-slide>
          <div class="section-title title-anim">最新文章</div>
          <div class="post-list">
            {posts.map((p, i) => (
              <a class="post-card reveal" style={`--rd:${i * 70}ms`} href={`/posts/${p.id}/`}>
                <h3>{p.data.title}</h3>
                <div class="meta">{p.data.date.toLocaleDateString('zh-CN')}</div>
                {p.data.summary && <div class="summary">{p.data.summary}</div>}
                {p.data.tags.length > 0 && (
                  <div class="tags">
                    {p.data.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
              </a>
            ))}
            {posts.length === 0 && <p style="color:var(--muted)">还没有文章，去 <code>src/content/posts/</code> 写一篇吧。</p>}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 友链 ===== */}
  <section class="page-section" id="friends">
    <div class="page-grid">
      <aside class="page-outline">
        <div class="po-title">友链</div>
        <div class="po-sep"></div>
        <a href="#friends-slide" data-anchor>朋友们</a>
      </aside>
      <div class="page-body">
        <div class="sub-slide" id="friends-slide" data-slide>
          <h2 class="sub-title">友链</h2>
          <p style="color:var(--muted)">一些朋友的小站，欢迎去看看。</p>
          <div class="friends reveal">
            {friends.map((f) => (
              <a class="friend" href={f.url} target="_blank" rel="noopener">
                <span class="avatar"></span>
                <span>{f.name}</span>
              </a>
            ))}
          </div>
          <p style="color:var(--muted);margin-top:24px;font-size:14px">想交换友链？在文章下留言，或邮件联系我。</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // 读取主题变量颜色(供 Canvas 跟随配色)
    function readVarRGB(name: string, fallback: [number, number, number]): [number, number, number] {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const m = /^#?([0-9a-f]{6})$/i.exec(v);
      if (m) {
        const n = parseInt(m[1], 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      return fallback;
    }

    // 背景: 俯视海浪点阵(Canvas, 低开销)
    function initHeroDots() {
      const canvas = document.querySelector('canvas.hero-dots') as HTMLCanvasElement | null;
      if (!canvas || canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const GAP = 22;
      // 波谷→波峰: 灰蓝(有但不发光) → 高亮高饱和蓝
      const BUCKETS = 7;
      let [ar, ag, ab] = readVarRGB('--accent', [110, 168, 255]);
      let [nr, ng, nb] = readVarRGB('--fg', [232, 233, 236]);
      let colors: string[] = [];
      let HALO = '';
      const buildColors = () => {
        colors = Array.from({ length: BUCKETS }, (_, k) => {
          const v = k / (BUCKETS - 1);
          const r = Math.round(nr + (ar - nr) * v);
          const g = Math.round(ng + (ag - ng) * v);
          const b = Math.round(nb + (ab - nb) * v);
          const a = 0.1 + 0.85 * Math.pow(v, 1.6);
          return `rgba(${r},${g},${b},${a.toFixed(3)})`;
        });
        HALO = `rgba(${Math.min(255, ar + 20)},${Math.min(255, ag + 20)},${Math.min(255, ab + 20)},0.22)`;
      };
      buildColors();
      document.addEventListener('palettechange', () => {
        [ar, ag, ab] = readVarRGB('--accent', [110, 168, 255]);
        [nr, ng, nb] = readVarRGB('--fg', [232, 233, 236]);
        buildColors();
      });
      const TRAIL_MS = 280, R_TRAIL = 42, RIPPLE_MS = 1500, R_BAND = 34;
      const trail: { x: number; y: number; t: number }[] = [];
      const ripples: { x: number; y: number; t0: number; max: number; amp: number; ring: boolean }[] = [];
      let w = 0, h = 0, raf = 0, running = false, lastWake = 0;

      let cols = 0, rows = 0;
      let fx = new Float32Array(0), fy = new Float32Array(0), fb = new Float32Array(0);

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cols = Math.ceil(w / GAP) + 2;
        rows = Math.ceil(h / GAP) + 2;
        fx = new Float32Array(cols * rows);
        fy = new Float32Array(cols * rows);
        fb = new Float32Array(cols * rows);
      };

      // 影响源先累加到位场, 点阵只读场 → 成本 O(源×邻近点) 而非 O(点×源)
      const splatTrail = (now: number) => {
        for (let k = 0; k < trail.length; k++) {
          const p = trail[k];
          const ageF = 1 - (now - p.t) / TRAIL_MS;
          if (ageF <= 0) continue;
          const i0 = Math.max(0, Math.floor((p.x - R_TRAIL) / GAP));
          const i1 = Math.min(cols - 1, Math.ceil((p.x + R_TRAIL) / GAP) + 1);
          const j0 = Math.max(0, Math.floor((p.y - R_TRAIL) / GAP));
          const j1 = Math.min(rows - 1, Math.ceil((p.y + R_TRAIL) / GAP) + 1);
          for (let i = i0; i <= i1; i++) {
            const ddx = (i - 0.5) * GAP - p.x;
            const dx2 = ddx * ddx;
            for (let j = j0; j <= j1; j++) {
              const ddy = (j - 0.5) * GAP - p.y;
              const d2 = dx2 + ddy * ddy;
              if (d2 >= R_TRAIL * R_TRAIL) continue;
              const d = Math.sqrt(d2) || 1;
              const fall = (1 - d / R_TRAIL) * ageF;
              const idx = i * rows + j;
              fx[idx] += (ddx / d) * fall * 6;
              fy[idx] += (ddy / d) * fall * 6;
              fb[idx] += fall * 0.3;
            }
          }
        }
      };

      const splatRipples = (now: number) => {
        for (let k = 0; k < ripples.length; k++) {
          const rp = ripples[k];
          const age = (now - rp.t0) / RIPPLE_MS;
          if (age >= 1) continue;
          const rad = age * rp.max;
          const outer = rad + R_BAND;
          const inner = rad - R_BAND;
          const inner2 = inner > 0 ? inner * inner : 0;
          const outer2 = outer * outer;
          const i0 = Math.max(0, Math.floor((rp.x - outer) / GAP));
          const i1 = Math.min(cols - 1, Math.ceil((rp.x + outer) / GAP) + 1);
          const j0 = Math.max(0, Math.floor((rp.y - outer) / GAP));
          const j1 = Math.min(rows - 1, Math.ceil((rp.y + outer) / GAP) + 1);
          for (let i = i0; i <= i1; i++) {
            const ddx = (i - 0.5) * GAP - rp.x;
            const dx2 = ddx * ddx;
            for (let j = j0; j <= j1; j++) {
              const ddy = (j - 0.5) * GAP - rp.y;
              const d2 = dx2 + ddy * ddy;
              if (d2 > outer2 || d2 < inner2) continue;
              const d = Math.sqrt(d2) || 1;
              const band = d > rad ? d - rad : rad - d;
              const fall = (1 - band / R_BAND) * (1 - age) * rp.amp;
              const idx = i * rows + j;
              fx[idx] += (ddx / d) * fall * 16;
              fy[idx] += (ddy / d) * fall * 16;
              fb[idx] += fall * 0.9;
            }
          }
        }
      };

      const draw = (now: number) => {
        if (!canvas.isConnected) return;
        const t = now * 0.001;
        ctx.clearRect(0, 0, w, h);
        while (trail.length && now - trail[0].t > TRAIL_MS) trail.shift();
        for (let k = ripples.length - 1; k >= 0; k--) if (now - ripples[k].t0 > RIPPLE_MS) ripples.splice(k, 1);

        fx.fill(0); fy.fill(0); fb.fill(0);
        splatTrail(now);
        splatRipples(now);

        for (let i = 0; i < cols; i++) {
          const bx = (i - 0.5) * GAP;
          for (let j = 0; j < rows; j++) {
            const by = (j - 0.5) * GAP;
            // 多向不等频正弦叠加 → 不规律的有机流动
            const dx = Math.sin(by * 0.019 + t * 0.73) * 7 + Math.sin((bx + by) * 0.0093 - t * 0.41) * 5;
            const dy = Math.sin(bx * 0.0165 - t * 0.61) * 7 + Math.cos((bx - by) * 0.0117 + t * 0.37) * 5;
            // 波面高度: 两组干涉, 波峰亮/波谷暗
            let v =
              0.5 +
              0.5 * (0.7 * Math.sin(bx * 0.017 + by * 0.012 + t * 1.05) + 0.3 * Math.sin(bx * 0.031 - by * 0.021 - t * 0.77));
            const idx = i * rows + j;
            v += fb[idx];
            v = v < 0 ? 0 : v > 1 ? 1 : v;
            const s = 0.7 + 1.3 * v;
            const x = bx + dx + fx[idx], y = by + dy + fy[idx];
            if (v > 0.68) {
              ctx.fillStyle = HALO;
              ctx.fillRect(x - s * 0.8, y - s * 0.8, s * 1.6, s * 1.6);
            }
            ctx.fillStyle = colors[Math.round(v * (BUCKETS - 1))];
            ctx.fillRect(x - s / 2, y - s / 2, s, s);
          }
        }
        // 粒子拖尾(发光)
        if (trail.length > 1) {
          ctx.globalCompositeOperation = 'lighter';
          for (let k = 0; k < trail.length; k++) {
            const p = trail[k];
            const age = 1 - (now - p.t) / TRAIL_MS;
            const r = 0.6 + 1.4 * age;
            ctx.fillStyle = `rgba(150,205,255,${(age * 0.75).toFixed(3)})`;
            ctx.fillRect(p.x - r / 2, p.y - r / 2, r, r);
          }
          ctx.globalCompositeOperation = 'source-over';
        }
        // 点击波纹圈
        for (let k = 0; k < ripples.length; k++) {
          const rp = ripples[k];
          if (!rp.ring) continue;
          const age = (now - rp.t0) / RIPPLE_MS;
          ctx.strokeStyle = `rgba(120,190,255,${(0.3 * (1 - age)).toFixed(3)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(rp.x, rp.y, Math.max(0, age * rp.max), 0, 6.2832);
          ctx.stroke();
        }

        if (running) raf = requestAnimationFrame(draw);
      };

      const start = () => {
        if (running) return;
        running = true;
        raf = requestAnimationFrame(draw);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      // 指针交互: 粒子拖尾 + 船迹尾流 + 点击波纹
      let lastPt: { x: number; y: number } | null = null;
      const onMove = (e: PointerEvent) => {
        if (!canvas.isConnected) {
          window.removeEventListener('pointermove', onMove);
          return;
        }
        const r = canvas.getBoundingClientRect();
        const now = performance.now();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        // 沿路径补点 → 快速移动也留下连续尾迹
        if (lastPt) {
          const mdx = x - lastPt.x, mdy = y - lastPt.y;
          const dist = Math.hypot(mdx, mdy);
          const steps = Math.min(Math.ceil(dist / 10), 6);
          for (let s = 1; s <= steps; s++) {
            trail.push({ x: lastPt.x + (mdx * s) / steps, y: lastPt.y + (mdy * s) / steps, t: now });
          }
        } else {
          trail.push({ x, y, t: now });
        }
        lastPt = { x, y };
        if (trail.length > 14) trail.splice(0, trail.length - 14);
        if (now - lastWake > 130) {
          lastWake = now;
          ripples.push({ x, y, t0: now, max: 50, amp: 0.3, ring: false });
          if (ripples.length > 16) ripples.shift();
        }
      };
      const onDown = (e: PointerEvent) => {
        if (!canvas.isConnected) {
          window.removeEventListener('pointerdown', onDown);
          return;
        }
        const r = canvas.getBoundingClientRect();
        const now = performance.now();
        ripples.push({ x: e.clientX - r.left, y: e.clientY - r.top, t0: now, max: 320, amp: 1.5, ring: true });
        if (ripples.length > 16) ripples.shift();
      };
      const onLeave = () => {
        trail.length = 0;
        lastPt = null;
      };

      resize();
      new ResizeObserver(resize).observe(canvas);
      if (reduce) {
        draw(0);
      } else {
        window.addEventListener('pointermove', onMove, { passive: true });
        window.addEventListener('pointerdown', onDown, { passive: true });
        window.addEventListener('blur', onLeave);
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { threshold: 0 }
        ).observe(canvas);
      }
    }
    document.addEventListener('astro:page-load', initHeroDots);
    initHeroDots();

    // 最新文章背景: 星星闪烁 + 流星雨
    function initPostsFx() {
      const canvas = document.querySelector('canvas.posts-fx') as HTMLCanvasElement | null;
      if (!canvas || canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rand = (a: number, b: number) => a + Math.random() * (b - a);
      const stars: { x: number; y: number; r: number; phase: number; speed: number }[] = [];
      const meteors: { x: number; y: number; vx: number; vy: number; len: number; life: number; maxLife: number }[] = [];
      let [mr, mg, mb] = readVarRGB('--accent', [110, 168, 255]);
      let [sr, sg, sb] = readVarRGB('--fg', [232, 233, 236]);
      document.addEventListener('palettechange', () => {
        [mr, mg, mb] = readVarRGB('--accent', [110, 168, 255]);
        [sr, sg, sb] = readVarRGB('--fg', [232, 233, 236]);
      });
      let w = 0, h = 0, raf = 0, running = false, lastMeteor = 0, nextMeteor = 1200;

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        stars.length = 0;
        const n = Math.min(300, Math.round((w * h) / 5800));
        for (let i = 0; i < n; i++) {
          stars.push({ x: rand(0, w), y: rand(0, h), r: rand(0.5, 1.6), phase: rand(0, Math.PI * 2), speed: rand(0.6, 1.8) });
        }
      };

      const spawnMeteor = () => {
        const rightward = Math.random() < 0.65;
        const speed = rand(6, 11);
        const ang = rand(0.35, 0.6);
        meteors.push({
          x: rightward ? rand(-120, w * 0.55) : rand(w * 0.45, w + 120),
          y: rand(-80, h * 0.22),
          vx: Math.cos(ang) * speed * (rightward ? 1 : -1),
          vy: Math.sin(ang) * speed,
          len: rand(90, 200),
          life: 0,
          maxLife: rand(1.1, 1.9),
        });
      };

      const draw = (now: number) => {
        if (!canvas.isConnected) return;
        const t = now * 0.001;
        ctx.clearRect(0, 0, w, h);

        // 星星闪烁
        ctx.fillStyle = `rgb(${sr},${sg},${sb})`;
        for (const s of stars) {
          const tw = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase));
          ctx.globalAlpha = tw;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, 6.2832);
          ctx.fill();
        }
        ctx.globalAlpha = 1;

        // 流星
        for (let i = meteors.length - 1; i >= 0; i--) {
          const m = meteors[i];
          m.x += m.vx;
          m.y += m.vy;
          m.life += 1 / 60;
          const fade = 1 - m.life / m.maxLife;
          if (fade <= 0 || m.x < -320 || m.x > w + 320 || m.y > h + 320) {
            meteors.splice(i, 1);
            continue;
          }
          const mag = Math.hypot(m.vx, m.vy) || 1;
          const tx = m.x - (m.vx / mag) * m.len;
          const ty = m.y - (m.vy / mag) * m.len;
          const grad = ctx.createLinearGradient(m.x, m.y, tx, ty);
          grad.addColorStop(0, `rgba(${sr},${sg},${sb},${(0.9 * fade).toFixed(3)})`);
          grad.addColorStop(0.45, `rgba(${mr},${mg},${mb},${(0.36 * fade).toFixed(3)})`);
          grad.addColorStop(1, `rgba(${mr},${mg},${mb},0)`);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.6;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(m.x, m.y);
          ctx.lineTo(tx, ty);
          ctx.stroke();
          ctx.fillStyle = `rgba(245,250,255,${(0.95 * fade).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(m.x, m.y, 1.7, 0, 6.2832);
          ctx.fill();
        }

        // 随机生成流星
        if (now - lastMeteor > nextMeteor) {
          lastMeteor = now;
          nextMeteor = rand(550, 1900);
          spawnMeteor();
          if (Math.random() < 0.5) spawnMeteor();
          if (Math.random() < 0.18) spawnMeteor();
        }

        if (running) raf = requestAnimationFrame(draw);
      };

      const start = () => {
        if (running) return;
        running = true;
        raf = requestAnimationFrame(draw);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      resize();
      new ResizeObserver(resize).observe(canvas);
      if (reduce) {
        draw(0);
      } else {
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { threshold: 0 }
        ).observe(canvas);
      }
    }
    document.addEventListener('astro:page-load', initPostsFx);
    initPostsFx();

    // 首屏简介打字机
    function initType() {
      const el = document.querySelector('.hero p .type') as HTMLElement | null;
      if (!el || el.dataset.done) return;
      el.dataset.done = '1';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const text = el.dataset.text || el.textContent || '';
      const p = el.closest('p');
      el.textContent = '';
      if (p) p.classList.add('typing');
      let i = 0;
      setTimeout(() => {
        const timer = setInterval(() => {
          el.textContent = text.slice(0, ++i);
          if (i >= text.length) {
            clearInterval(timer);
            setTimeout(() => p?.classList.remove('typing'), 700);
          }
        }, 45);
      }, 850);
    }
    document.addEventListener('astro:page-load', initType);
    initType();

    // 搜索(Pagefind UI, 构建后可用)
    function initSearch() {
      const el = document.getElementById('search-ui');
      if (!el || el.dataset.init) return;
      if ((window as any).PagefindUI) {
        el.dataset.init = '1';
        new (window as any).PagefindUI({
          element: '#search-ui',
          showSubResults: true,
          translations: { placeholder: '搜索文章…', zero_results: '没有找到「[SEARCH_TERM]」' },
        });
      } else if (!el.innerHTML.trim()) {
        el.innerHTML = '<p style="color:var(--muted)">搜索索引在<b>构建后</b>生成：跑 <code>npm run build</code> 再 <code>npm run preview</code> 即可用（dev 模式没有索引）。</p>';
      }
    }
    document.addEventListener('astro:page-load', initSearch);
    initSearch();

    // 顶栏 + 左侧目录: 高亮当前区块/子页
    function initSpy() {
      if (!document.getElementById('hero')) return;
      const headerH = () => {
        const h = document.querySelector('.site-header') as HTMLElement | null;
        return h ? h.offsetHeight : 64;
      };
      const sectionIds = ['hero', 'about', 'search', 'gallery', 'posts', 'friends'];
      const onScroll = () => {
        const y = window.scrollY + headerH() + 28;
        let sec = 'hero';
        for (const id of sectionIds) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top + window.scrollY <= y) sec = id;
        }
        document.querySelectorAll('.nav a[data-anchor]').forEach((a) => {
          a.classList.toggle('active', a.getAttribute('href') === '#' + sec);
        });
        let cur: HTMLElement | null = null;
        for (const el of Array.from(document.querySelectorAll('[data-slide]')) as HTMLElement[]) {
          if (el.getBoundingClientRect().top + window.scrollY <= y) cur = el;
        }
        document.querySelectorAll('.page-outline a').forEach((a) => {
          a.classList.toggle('active', !!cur && a.getAttribute('href') === '#' + cur.id);
        });
      };
      const w2 = window as any;
      if (w2.__spyScroll) removeEventListener('scroll', w2.__spyScroll);
      w2.__spyScroll = onScroll;
      addEventListener('scroll', w2.__spyScroll, { passive: true });
      onScroll();
    }
    document.addEventListener('astro:page-load', initSpy);
    initSpy();

    // 首页磁性翻页: 在所有 [data-slide] 区块之间翻页(滚轮 + 顶栏锚点)
    if (!(window as any).__pptWheel) {
      (window as any).__pptWheel = true;
      let lock = false;
      const headerH = () => {
        const h = document.querySelector('.site-header') as HTMLElement | null;
        return h ? h.offsetHeight : 64;
      };
      const slideTops = () =>
        Array.from(document.querySelectorAll('[data-slide]')).map((el) => {
          const r = (el as HTMLElement).getBoundingClientRect();
          return Math.max(0, Math.round(r.top + window.scrollY - headerH()));
        });
      const goto = (top: number) => {
        lock = true;
        window.scrollTo({ top, behavior: 'smooth' });
        setTimeout(() => (lock = false), 800);
      };
      window.addEventListener(
        'wheel',
        (e) => {
          if (lock || !document.querySelector('[data-slide]')) return;
          const els = Array.from(document.querySelectorAll('[data-slide]')) as HTMLElement[];
          if (!els.length) return;
          const hh = headerH();
          const y = window.scrollY;
          const tops = els.map((el) => Math.max(0, Math.round(el.getBoundingClientRect().top + y - hh)));
          let idx = 0;
          for (let i = 0; i < els.length; i++) if (tops[i] <= y + 8) idx = i;
          const cur = els[idx];
          const curTop = tops[idx];
          const curBottom = cur.getBoundingClientRect().bottom + y;
          if (e.deltaY > 0) {
            const nextTop = tops[idx + 1];
            if (nextTop !== undefined && y + window.innerHeight >= curBottom - 8) {
              e.preventDefault();
              goto(nextTop);
            }
          } else if (e.deltaY < 0) {
            const prevTop = tops[idx - 1];
            if (prevTop !== undefined && y <= curTop + 8) {
              e.preventDefault();
              goto(prevTop);
            }
          }
        },
        { passive: false }
      );
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!t.closest) return;
        const a = t.closest('a[data-anchor]') as HTMLAnchorElement | null;
        if (!a || lock) return;
        const href = a.getAttribute('href') || '';
        e.preventDefault();
        if (href === '#top') {
          goto(0);
          return;
        }
        const el = document.querySelector(href) as HTMLElement | null;
        if (el) goto(Math.max(0, Math.round(el.getBoundingClientRect().top + window.scrollY - headerH())));
      });
    }
  </script>
</Base>
