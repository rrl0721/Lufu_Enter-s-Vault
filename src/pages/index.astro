---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base>
  <section class="hero">
    <canvas class="hero-dots" aria-hidden="true"></canvas>
    <img
      class="hero-bg"
      src="/hero-art.webp"
      alt=""
      aria-hidden="true"
      width="1000"
      height="1000"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-inner">
      <div class="hero-status"><span class="pulse"></span>正在折腾 Astro</div>
      <h1 aria-label="你好，我是Lufu_Enter。">
        {[...'你好，我是'].map((c, i) => (
          <span class="ch" style={`--d:${(0.18 + i * 0.05).toFixed(2)}s`}>{c}</span>
        ))}
        <span class="grad ch-block" style="--d:.48s">Lufu_Enter</span>
        <span class="ch" style="--d:.72s">。</span>
      </h1>
      <p aria-label="这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。">
        <span class="type" data-text="这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。">这里是我的小站 —— 记录技术、生活，和一些没头没尾的想法。慢慢写，慢慢长。</span>
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#posts">阅读文章</a>
        <a class="btn" href="/about/">关于我</a>
      </div>
      <div class="hero-social">
        <a class="social-btn" href="https://github.com/rrl0721" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub · rrl0721">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.01 11.01 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a class="social-btn" href="mailto:1510518297@qq.com" aria-label="邮箱 QQ" title="1510518297@qq.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.8 5.6L19.8 6H4.2zM4 8.2V18h16V8.2l-7.4 5.3a1 1 0 0 1-1.2 0L4 8.2z"/></svg>
        </a>
        <a class="social-btn" href="mailto:lzr20071130@outlook.com" aria-label="邮箱 Outlook" title="lzr20071130@outlook.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.2.5 7.8 5.6L19.8 6H4.2zM4 8.2V18h16V8.2l-7.4 5.3a1 1 0 0 1-1.2 0L4 8.2z"/></svg>
        </a>
        <a class="social-btn" href="/rss.xml" aria-label="RSS" title="RSS 订阅">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM3 10v3a8 8 0 0 1 8 8h3A11 11 0 0 0 3 10zm0-6v3a14 14 0 0 1 14 14h3A17 17 0 0 0 3 4z"/></svg>
        </a>
      </div>
    </div>
    <a class="hero-scroll" href="#posts" aria-label="向下滚动">
      <span></span>
    </a>
  </section>

  <section id="posts" class="posts">
    <canvas class="posts-fx" aria-hidden="true"></canvas>
    <div class="wrap posts-inner">
      <div class="section-title title-anim">最新文章</div>
      <div class="post-list">
        {posts.map((p, i) => (
          <a class="post-card reveal" style={`--rd:${i * 70}ms`} href={`/posts/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <div class="meta">{p.data.date.toLocaleDateString('zh-CN')}</div>
            {p.data.summary && <div class="summary">{p.data.summary}</div>}
            {p.data.tags.length > 0 && (
              <div class="tags">
                {p.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </a>
        ))}
        {posts.length === 0 && <p style="color:var(--muted)">还没有文章，去 <code>src/content/posts/</code> 写一篇吧。</p>}
      </div>
    </div>
  </section>

  <script>
    // 读取主题主色(供 Canvas 跟随配色)
    function readAccentRGB(): [number, number, number] {
      const v = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      const m = /^#?([0-9a-f]{6})$/i.exec(v);
      if (m) {
        const n = parseInt(m[1], 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      return [110, 168, 255];
    }

    // 背景: 俯视海浪点阵(Canvas, 低开销)
    function initHeroDots() {
      const canvas = document.querySelector('canvas.hero-dots') as HTMLCanvasElement | null;
      if (!canvas || canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const GAP = 22;
      // 波谷→波峰: 灰蓝(有但不发光) → 高亮高饱和蓝
      const BUCKETS = 7;
      let [ar, ag, ab] = readAccentRGB();
      let colors: string[] = [];
      let HALO = '';
      const buildColors = () => {
        colors = Array.from({ length: BUCKETS }, (_, k) => {
          const v = k / (BUCKETS - 1);
          const r = Math.round(145 + (ar - 145) * v);
          const g = Math.round(152 + (ag - 152) * v);
          const b = Math.round(165 + (ab - 165) * v);
          const a = 0.1 + 0.85 * Math.pow(v, 1.6);
          return `rgba(${r},${g},${b},${a.toFixed(3)})`;
        });
        HALO = `rgba(${Math.min(255, ar + 20)},${Math.min(255, ag + 20)},${Math.min(255, ab + 20)},0.22)`;
      };
      buildColors();
      document.addEventListener('palettechange', () => {
        [ar, ag, ab] = readAccentRGB();
        buildColors();
      });
      const TRAIL_MS = 280, R_TRAIL = 42, RIPPLE_MS = 1500, R_BAND = 34;
      const trail: { x: number; y: number; t: number }[] = [];
      const ripples: { x: number; y: number; t0: number; max: number; amp: number; ring: boolean }[] = [];
      let w = 0, h = 0, raf = 0, running = false, lastWake = 0;

      let cols = 0, rows = 0;
      let fx = new Float32Array(0), fy = new Float32Array(0), fb = new Float32Array(0);

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        cols = Math.ceil(w / GAP) + 2;
        rows = Math.ceil(h / GAP) + 2;
        fx = new Float32Array(cols * rows);
        fy = new Float32Array(cols * rows);
        fb = new Float32Array(cols * rows);
      };

      // 影响源先累加到位场, 点阵只读场 → 成本 O(源×邻近点) 而非 O(点×源)
      const splatTrail = (now: number) => {
        for (let k = 0; k < trail.length; k++) {
          const p = trail[k];
          const ageF = 1 - (now - p.t) / TRAIL_MS;
          if (ageF <= 0) continue;
          const i0 = Math.max(0, Math.floor((p.x - R_TRAIL) / GAP));
          const i1 = Math.min(cols - 1, Math.ceil((p.x + R_TRAIL) / GAP) + 1);
          const j0 = Math.max(0, Math.floor((p.y - R_TRAIL) / GAP));
          const j1 = Math.min(rows - 1, Math.ceil((p.y + R_TRAIL) / GAP) + 1);
          for (let i = i0; i <= i1; i++) {
            const ddx = (i - 0.5) * GAP - p.x;
            const dx2 = ddx * ddx;
            for (let j = j0; j <= j1; j++) {
              const ddy = (j - 0.5) * GAP - p.y;
              const d2 = dx2 + ddy * ddy;
              if (d2 >= R_TRAIL * R_TRAIL) continue;
              const d = Math.sqrt(d2) || 1;
              const fall = (1 - d / R_TRAIL) * ageF;
              const idx = i * rows + j;
              fx[idx] += (ddx / d) * fall * 6;
              fy[idx] += (ddy / d) * fall * 6;
              fb[idx] += fall * 0.3;
            }
          }
        }
      };

      const splatRipples = (now: number) => {
        for (let k = 0; k < ripples.length; k++) {
          const rp = ripples[k];
          const age = (now - rp.t0) / RIPPLE_MS;
          if (age >= 1) continue;
          const rad = age * rp.max;
          const outer = rad + R_BAND;
          const inner = rad - R_BAND;
          const inner2 = inner > 0 ? inner * inner : 0;
          const outer2 = outer * outer;
          const i0 = Math.max(0, Math.floor((rp.x - outer) / GAP));
          const i1 = Math.min(cols - 1, Math.ceil((rp.x + outer) / GAP) + 1);
          const j0 = Math.max(0, Math.floor((rp.y - outer) / GAP));
          const j1 = Math.min(rows - 1, Math.ceil((rp.y + outer) / GAP) + 1);
          for (let i = i0; i <= i1; i++) {
            const ddx = (i - 0.5) * GAP - rp.x;
            const dx2 = ddx * ddx;
            for (let j = j0; j <= j1; j++) {
              const ddy = (j - 0.5) * GAP - rp.y;
              const d2 = dx2 + ddy * ddy;
              if (d2 > outer2 || d2 < inner2) continue;
              const d = Math.sqrt(d2) || 1;
              const band = d > rad ? d - rad : rad - d;
              const fall = (1 - band / R_BAND) * (1 - age) * rp.amp;
              const idx = i * rows + j;
              fx[idx] += (ddx / d) * fall * 16;
              fy[idx] += (ddy / d) * fall * 16;
              fb[idx] += fall * 0.9;
            }
          }
        }
      };

      const draw = (now: number) => {
        if (!canvas.isConnected) return;
        const t = now * 0.001;
        ctx.clearRect(0, 0, w, h);
        while (trail.length && now - trail[0].t > TRAIL_MS) trail.shift();
        for (let k = ripples.length - 1; k >= 0; k--) if (now - ripples[k].t0 > RIPPLE_MS) ripples.splice(k, 1);

        fx.fill(0); fy.fill(0); fb.fill(0);
        splatTrail(now);
        splatRipples(now);

        for (let i = 0; i < cols; i++) {
          const bx = (i - 0.5) * GAP;
          for (let j = 0; j < rows; j++) {
            const by = (j - 0.5) * GAP;
            // 多向不等频正弦叠加 → 不规律的有机流动
            const dx = Math.sin(by * 0.019 + t * 0.73) * 7 + Math.sin((bx + by) * 0.0093 - t * 0.41) * 5;
            const dy = Math.sin(bx * 0.0165 - t * 0.61) * 7 + Math.cos((bx - by) * 0.0117 + t * 0.37) * 5;
            // 波面高度: 两组干涉, 波峰亮/波谷暗
            let v =
              0.5 +
              0.5 * (0.7 * Math.sin(bx * 0.017 + by * 0.012 + t * 1.05) + 0.3 * Math.sin(bx * 0.031 - by * 0.021 - t * 0.77));
            const idx = i * rows + j;
            v += fb[idx];
            v = v < 0 ? 0 : v > 1 ? 1 : v;
            const s = 0.7 + 1.3 * v;
            const x = bx + dx + fx[idx], y = by + dy + fy[idx];
            if (v > 0.68) {
              ctx.fillStyle = HALO;
              ctx.fillRect(x - s * 0.8, y - s * 0.8, s * 1.6, s * 1.6);
            }
            ctx.fillStyle = colors[Math.round(v * (BUCKETS - 1))];
            ctx.fillRect(x - s / 2, y - s / 2, s, s);
          }
        }
        // 粒子拖尾(发光)
        if (trail.length > 1) {
          ctx.globalCompositeOperation = 'lighter';
          for (let k = 0; k < trail.length; k++) {
            const p = trail[k];
            const age = 1 - (now - p.t) / TRAIL_MS;
            const r = 0.6 + 1.4 * age;
            ctx.fillStyle = `rgba(150,205,255,${(age * 0.75).toFixed(3)})`;
            ctx.fillRect(p.x - r / 2, p.y - r / 2, r, r);
          }
          ctx.globalCompositeOperation = 'source-over';
        }
        // 点击波纹圈
        for (let k = 0; k < ripples.length; k++) {
          const rp = ripples[k];
          if (!rp.ring) continue;
          const age = (now - rp.t0) / RIPPLE_MS;
          ctx.strokeStyle = `rgba(120,190,255,${(0.3 * (1 - age)).toFixed(3)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(rp.x, rp.y, Math.max(0, age * rp.max), 0, 6.2832);
          ctx.stroke();
        }

        if (running) raf = requestAnimationFrame(draw);
      };

      const start = () => {
        if (running) return;
        running = true;
        raf = requestAnimationFrame(draw);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      // 指针交互: 粒子拖尾 + 船迹尾流 + 点击波纹
      let lastPt: { x: number; y: number } | null = null;
      const onMove = (e: PointerEvent) => {
        if (!canvas.isConnected) {
          window.removeEventListener('pointermove', onMove);
          return;
        }
        const r = canvas.getBoundingClientRect();
        const now = performance.now();
        const x = e.clientX - r.left, y = e.clientY - r.top;
        // 沿路径补点 → 快速移动也留下连续尾迹
        if (lastPt) {
          const mdx = x - lastPt.x, mdy = y - lastPt.y;
          const dist = Math.hypot(mdx, mdy);
          const steps = Math.min(Math.ceil(dist / 10), 6);
          for (let s = 1; s <= steps; s++) {
            trail.push({ x: lastPt.x + (mdx * s) / steps, y: lastPt.y + (mdy * s) / steps, t: now });
          }
        } else {
          trail.push({ x, y, t: now });
        }
        lastPt = { x, y };
        if (trail.length > 14) trail.splice(0, trail.length - 14);
        if (now - lastWake > 130) {
          lastWake = now;
          ripples.push({ x, y, t0: now, max: 50, amp: 0.3, ring: false });
          if (ripples.length > 16) ripples.shift();
        }
      };
      const onDown = (e: PointerEvent) => {
        if (!canvas.isConnected) {
          window.removeEventListener('pointerdown', onDown);
          return;
        }
        const r = canvas.getBoundingClientRect();
        const now = performance.now();
        ripples.push({ x: e.clientX - r.left, y: e.clientY - r.top, t0: now, max: 320, amp: 1.5, ring: true });
        if (ripples.length > 16) ripples.shift();
      };
      const onLeave = () => {
        trail.length = 0;
        lastPt = null;
      };

      resize();
      new ResizeObserver(resize).observe(canvas);
      if (reduce) {
        draw(0);
      } else {
        window.addEventListener('pointermove', onMove, { passive: true });
        window.addEventListener('pointerdown', onDown, { passive: true });
        window.addEventListener('blur', onLeave);
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { threshold: 0 }
        ).observe(canvas);
      }
    }
    document.addEventListener('astro:page-load', initHeroDots);
    initHeroDots();

    // 最新文章背景: 星星闪烁 + 流星雨
    function initPostsFx() {
      const canvas = document.querySelector('canvas.posts-fx') as HTMLCanvasElement | null;
      if (!canvas || canvas.dataset.ready) return;
      canvas.dataset.ready = '1';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rand = (a: number, b: number) => a + Math.random() * (b - a);
      const stars: { x: number; y: number; r: number; phase: number; speed: number }[] = [];
      const meteors: { x: number; y: number; vx: number; vy: number; len: number; life: number; maxLife: number }[] = [];
      let [mr, mg, mb] = readAccentRGB();
      document.addEventListener('palettechange', () => { [mr, mg, mb] = readAccentRGB(); });
      let w = 0, h = 0, raf = 0, running = false, lastMeteor = 0, nextMeteor = 1200;

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        w = r.width; h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        stars.length = 0;
        const n = Math.min(300, Math.round((w * h) / 5800));
        for (let i = 0; i < n; i++) {
          stars.push({ x: rand(0, w), y: rand(0, h), r: rand(0.5, 1.6), phase: rand(0, Math.PI * 2), speed: rand(0.6, 1.8) });
        }
      };

      const spawnMeteor = () => {
        const rightward = Math.random() < 0.65;
        const speed = rand(6, 11);
        const ang = rand(0.35, 0.6);
        meteors.push({
          x: rightward ? rand(-120, w * 0.55) : rand(w * 0.45, w + 120),
          y: rand(-80, h * 0.22),
          vx: Math.cos(ang) * speed * (rightward ? 1 : -1),
          vy: Math.sin(ang) * speed,
          len: rand(90, 200),
          life: 0,
          maxLife: rand(1.1, 1.9),
        });
      };

      const draw = (now: number) => {
        if (!canvas.isConnected) return;
        const t = now * 0.001;
        ctx.clearRect(0, 0, w, h);

        // 星星闪烁
        ctx.fillStyle = '#dce8ff';
        for (const s of stars) {
          const tw = 0.3 + 0.7 * (0.5 + 0.5 * Math.sin(t * s.speed + s.phase));
          ctx.globalAlpha = tw;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, 6.2832);
          ctx.fill();
        }
        ctx.globalAlpha = 1;

        // 流星
        for (let i = meteors.length - 1; i >= 0; i--) {
          const m = meteors[i];
          m.x += m.vx;
          m.y += m.vy;
          m.life += 1 / 60;
          const fade = 1 - m.life / m.maxLife;
          if (fade <= 0 || m.x < -320 || m.x > w + 320 || m.y > h + 320) {
            meteors.splice(i, 1);
            continue;
          }
          const mag = Math.hypot(m.vx, m.vy) || 1;
          const tx = m.x - (m.vx / mag) * m.len;
          const ty = m.y - (m.vy / mag) * m.len;
          const grad = ctx.createLinearGradient(m.x, m.y, tx, ty);
          grad.addColorStop(0, `rgba(235,244,255,${(0.9 * fade).toFixed(3)})`);
          grad.addColorStop(0.45, `rgba(${mr},${mg},${mb},${(0.36 * fade).toFixed(3)})`);
          grad.addColorStop(1, `rgba(${mr},${mg},${mb},0)`);
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.6;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(m.x, m.y);
          ctx.lineTo(tx, ty);
          ctx.stroke();
          ctx.fillStyle = `rgba(245,250,255,${(0.95 * fade).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(m.x, m.y, 1.7, 0, 6.2832);
          ctx.fill();
        }

        // 随机生成流星
        if (now - lastMeteor > nextMeteor) {
          lastMeteor = now;
          nextMeteor = rand(550, 1900);
          spawnMeteor();
          if (Math.random() < 0.5) spawnMeteor();
          if (Math.random() < 0.18) spawnMeteor();
        }

        if (running) raf = requestAnimationFrame(draw);
      };

      const start = () => {
        if (running) return;
        running = true;
        raf = requestAnimationFrame(draw);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(raf);
      };

      resize();
      new ResizeObserver(resize).observe(canvas);
      if (reduce) {
        draw(0);
      } else {
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { threshold: 0 }
        ).observe(canvas);
      }
    }
    document.addEventListener('astro:page-load', initPostsFx);
    initPostsFx();

    // 首屏简介打字机
    function initType() {
      const el = document.querySelector('.hero p .type') as HTMLElement | null;
      if (!el || el.dataset.done) return;
      el.dataset.done = '1';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const text = el.dataset.text || el.textContent || '';
      const p = el.closest('p');
      el.textContent = '';
      if (p) p.classList.add('typing');
      let i = 0;
      setTimeout(() => {
        const timer = setInterval(() => {
          el.textContent = text.slice(0, ++i);
          if (i >= text.length) {
            clearInterval(timer);
            setTimeout(() => p?.classList.remove('typing'), 700);
          }
        }, 45);
      }, 850);
    }
    document.addEventListener('astro:page-load', initType);
    initType();

    // 首屏封面 → 最新文章: 滚轮磁性翻页 + 锚点按钮(仅首页生效)
    if (!(window as any).__pptWheel) {
      (window as any).__pptWheel = true;
      let lock = false;
      const goPosts = () => {
        const hero = document.querySelector('.hero');
        if (hero) window.scrollTo({ top: (hero as HTMLElement).offsetHeight, behavior: 'smooth' });
      };
      window.addEventListener(
        'wheel',
        (e) => {
          const hero = document.querySelector('.hero');
          const posts = document.querySelector('.posts');
          if (!hero || !posts || lock) return;
          const heroH = (hero as HTMLElement).offsetHeight;
          const y = window.scrollY;
          if (y < heroH * 0.5 && e.deltaY > 0) {
            e.preventDefault();
            lock = true;
            window.scrollTo({ top: heroH, behavior: 'smooth' });
            setTimeout(() => (lock = false), 800);
          } else if (y > 20 && y < heroH * 1.5 && e.deltaY < 0) {
            e.preventDefault();
            lock = true;
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => (lock = false), 800);
          }
        },
        { passive: false }
      );
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!t.closest) return;
        if (t.closest('a[href="#posts"]')) {
          e.preventDefault();
          goPosts();
        }
      });
    }
  </script>
</Base>
